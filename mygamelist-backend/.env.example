# Local development only. No quotes; no trailing comments. Never commit .env.
DATABASE_URL=jdbc:postgresql://localhost:5433/mygamelist
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
RAWG_API_KEY=CHANGE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
FRONTEND_URL=http://localhost:4200
JPA_DDL_AUTO=update
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USERNAME=mygamelist
RABBITMQ_PASSWORD=CHANGE_ME
OUTBOX_KEY=CHANGE_ME

# Numeric user IDs allowed to triage reports, comma-separated. Empty = no moderators.
MODERATOR_IDS=
COMMUNITY_AUTO_MIGRATE=true

# After Provision-Runtime.ps1, DATABASE_USERNAME/DATABASE_RUNTIME_PASSWORD and hardened profile are written to .env.
# Do not set an empty DATABASE_RUNTIME_PASSWORD here; omit it until provisioned.
SERVER_ADDRESS=127.0.0.1
MAX_INFLIGHT=32
GLOBAL_REQUESTS_PER_SECOND=120
# Exact addresses of the immediate reverse proxy. Empty for direct local access.
TRUSTED_PROXY_ADDRESSES=

# Optional: used only by scripts/Audit-Security.ps1, never by the running API.
# Request your own NVD key; keep the real value only in .env or CI secrets.
# NVD_API_KEY=YOUR_NVD_API_KEY
