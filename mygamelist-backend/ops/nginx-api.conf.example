# Local reverse-proxy example. Include these directives inside nginx's http {}.
# Public deployments REQUIRE a TLS listener + provider anti-DDoS/CDN/WAF and a private origin.
# Set TRUSTED_PROXY_ADDRESSES=127.0.0.1 only when this is the sole immediate proxy.
limit_req_zone $binary_remote_addr zone=mgl_per_ip:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=mgl_connections:10m;
server {
    listen 127.0.0.1:8081;
    server_name localhost;
    server_tokens off;
    client_max_body_size 384k;
    client_header_timeout 5s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        add_header Retry-After 10 always;
        return 429 '{"code":"RATE_LIMITED","message":"Muitas solicitacoes. Aguarde."}';
    }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location / {
        limit_req zone=mgl_per_ip burst=30 nodelay;
        limit_conn mgl_connections 10;
        proxy_request_buffering on;
        proxy_connect_timeout 2s;
        proxy_read_timeout 20s;
        proxy_send_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_pass http://127.0.0.1:8080;
    }
}
